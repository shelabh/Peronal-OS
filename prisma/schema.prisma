generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String   @default("User")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  habits        Habit[]
  projects      Project[]
  goals         Goal[]
  healthEntries HealthEntry[]
  dailyLogs     DailyLog[]
  weeklyReviews WeeklyReview[]
  metrics       Metric[]
  memories      Memory[]
  lifeAreas     LifeArea[]
  experiments   Experiment[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String?
  goalId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId  String
  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  goal    Goal?    @relation(fields: [goalId], references: [id])
}

model Habit {
  id          String      @id @default(cuid())
  name        String
  description String?
  habitType   HabitType   @default(BINARY)
  frequency   HabitFreq   @default(DAILY)
  cadenceRule String?
  color       String      @default("#6366f1")
  targetValue Float?
  unit        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId     String
  lifeAreaId String?
  goalId     String?
  user       User      @relation(fields: [userId], references: [id])
  lifeArea   LifeArea? @relation(fields: [lifeAreaId], references: [id])
  goal       Goal?     @relation(fields: [goalId], references: [id])
  logs       HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  completed Boolean  @default(false)
  status    HabitLogStatus @default(MISSED)
  value     Float?
  note      String?
  createdAt DateTime @default(now())

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id])

  @@unique([habitId, date])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  progress    Int           @default(0)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId     String
  lifeAreaId String?
  user       User      @relation(fields: [userId], references: [id])
  lifeArea   LifeArea? @relation(fields: [lifeAreaId], references: [id])
  tasks      Task[]
  goals      Goal[]
  metrics    Metric[]
  milestones ProjectMilestone[]
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  category    String?
  status      GoalStatus @default(IN_PROGRESS)
  progress    Int        @default(0)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId     String
  lifeAreaId String?
  user       User      @relation(fields: [userId], references: [id])
  lifeArea   LifeArea? @relation(fields: [lifeAreaId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  tasks      Task[]
  habits     Habit[]
  metrics    Metric[]
}

model HealthEntry {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  sleepHours Float?
  mood      Int?
  energy    Int?
  weight    Float?
  steps     Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyLog {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  reflection String?
  dailyScore Float?
  stress     Int?
  cravings   Int?
  recovery   Int?
  socialQuality      Int?
  environmentQuality Int?
  focusFriction      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model WeeklyReview {
  id            String   @id @default(cuid())
  weekStart     DateTime @db.Date
  wins          String?
  challenges    String?
  improvements  String?
  focusNextWeek String?
  rating        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, weekStart])
}

model LifeArea {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  goals    Goal[]
  habits   Habit[]
  projects Project[]
  metrics  Metric[]
}

model Metric {
  id          String   @id @default(cuid())
  name        String
  category    String?
  unit        String
  targetValue Float?
  direction   MetricDirection @default(INCREASE)
  signalRole  MetricSignalRole @default(BEHAVIOR)
  includeInInsights Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId     String
  lifeAreaId String?
  goalId     String?
  projectId  String?
  user       User         @relation(fields: [userId], references: [id])
  lifeArea   LifeArea?    @relation(fields: [lifeAreaId], references: [id])
  goal       Goal?        @relation(fields: [goalId], references: [id])
  project    Project?     @relation(fields: [projectId], references: [id])
  entries    MetricEntry[]
  experiments Experiment[]
}

model MetricEntry {
  id        String   @id @default(cuid())
  value     Float
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())

  metricId String
  metric   Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, date])
}

model Memory {
  id         String     @id @default(cuid())
  type       MemoryType
  content    String
  confidence Float      @default(0.7)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Experiment {
  id                 String           @id @default(cuid())
  title              String
  hypothesis         String
  status             ExperimentStatus @default(ACTIVE)
  relatedPatternKey  String?
  startDate          DateTime         @db.Date
  endDate            DateTime?        @db.Date
  reviewDate         DateTime?        @db.Date
  actions            Json
  successCriteria    Json?
  outcomeSummary     String?
  effectivenessScore Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  userId         String
  targetMetricId String?
  user           User    @relation(fields: [userId], references: [id])
  targetMetric   Metric? @relation(fields: [targetMetricId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model ProjectMilestone {
  id          String                 @id @default(cuid())
  title       String
  notes       String?
  status      ProjectMilestoneStatus @default(TODO)
  dueDate     DateTime?
  completedAt DateTime?
  orderIndex  Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, orderIndex])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum HabitFreq {
  DAILY
  WEEKLY
}

enum HabitType {
  BINARY
  QUANTITY
  THRESHOLD
}

enum HabitLogStatus {
  MISSED
  PARTIAL
  DONE
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum MetricDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum MetricSignalRole {
  BEHAVIOR
  STATE
  OUTCOME
  RISK
}

enum MemoryType {
  INSIGHT
  PREFERENCE
  STRATEGY
}

enum ExperimentStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ProjectMilestoneStatus {
  TODO
  IN_PROGRESS
  DONE
}
